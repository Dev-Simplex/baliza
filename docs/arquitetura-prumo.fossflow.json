      "icon": "router"
    },
    {
      "id": "proxy",
      "name": "proxy.ts - porteiro de rotas",
      "description": "Middleware do Next 16 (renomeado de middleware.ts). Decide sessao antes de renderizar.",
      "icon": "firewall"
    },
    {
      "id": "next",
      "name": "Next.js 16.2 - App Router",
      "description": "React 19.2 + Turbopack. RSC por padrao; 22 rotas, 5 estaticas.",
      "icon": "server"
    },
    {
      "id": "auth",
      "name": "NextAuth v5 - sessao JWT",
      "description": "5.0.0-beta.32 + @auth/prisma-adapter, bcryptjs. JWT e stateless: nao existe session store para hospedar.",
      "icon": "lock"
    },
    {
      "id": "actions",
      "name": "Server Actions - Zod",
      "description": "Mutacoes com validacao zod 4 na borda. Limite de corpo 8mb.",
      "icon": "function-module"
    },
    {
      "id": "prisma",
      "name": "Prisma 7.9 - adapter-pg",
      "description": "Driver adapter: o engine binario saiu do caminho. Client gerado em src/generated/prisma (gitignored).",
      "icon": "package-module"
    },
    {
      "id": "postgres",
      "name": "PostgreSQL - A PROVISIONAR",
      "description": "~22 modelos, 9 migrations, multi-tenant por organizationId. Guarda tambem o RateLimitCounter.",
      "icon": "storage"
    },
    {
      "id": "smtp",
      "name": "SMTP - nodemailer (opcional)",
      "description": "Ausencia DEGRADA: o convite cai no log em vez de derrubar o sistema.",
      "icon": "mail"
    },
    {
      "id": "openai",
      "name": "OpenAI (opcional)",
      "description": "Sem chave, o sistema usa o gerador deterministico. Nao e dependencia dura.",
      "icon": "cloud"
    },
    {
      "id": "saidas",
      "name": "PDF - Excel - QR",
      "description": "@react-pdf/renderer, exceljs e qrcode. Fora do bundle do cliente via serverExternalPackages.",
      "icon": "document"
    },
    {
      "id": "github",
      "name": "GitHub - Dev-Simplex/baliza",
      "description": "Branch main. Sem CI: nenhum workflow roda o build ou os 309 testes antes do deploy.",
      "icon": "cube"
    },
    {
      "id": "railpack",
      "name": "Railpack - build",
