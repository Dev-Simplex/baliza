// Prumo — mapeamento comportamental para processos seletivos.
//
// Regra de arquitetura: TUDO que pertence a uma empresa carrega `organizationId`
// e é lido exclusivamente pelos helpers de `src/lib/tenant.ts`. Consulta que
// esquece o escopo é vazamento de dados entre clientes, não bug de listagem.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════════
// Tenancy
// ══════════════════════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  document  String? // CNPJ, opcional
  logoUrl   String?
  website   String?
  segment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prazo de expurgo da resposta bruta (§7.5 do instrumento).
  retentionMonths Int     @default(12)
  isActive        Boolean @default(true)

  users           User[]
  jobs            Job[]
  candidates      Candidate[]
  invitations     Invitation[]
  assessments     Assessment[]
  cultureProfiles CultureProfile[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]

}

// ══════════════════════════════════════════════════════════════════════════
// Usuários e autenticação
// ══════════════════════════════════════════════════════════════════════════

enum UserRole {
  OWNER // dono da conta: tudo, inclusive faturamento
  ADMIN // administra vagas e usuários
  RECRUITER // opera vagas e candidatos
  VIEWER // só leitura
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String?
  emailVerified  DateTime?
  image          String?
  role           UserRole      @default(RECRUITER)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Operador da plataforma (painel administrativo). Vive FORA do escopo de tenant.
  isPlatformAdmin Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?

  // Primeiros passos do painel: guardado no usuário, e não no navegador, para
  // que quem já aprendeu não veja o tutorial de novo ao trocar de máquina.
  onboardingDoneAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  createdJobs Job[]        @relation("JobCreatedBy")
  invitations Invitation[] @relation("InvitationCreatedBy")
  auditLogs   AuditLog[]
  pareceres   Assessment[] @relation("PareceresDoAnalista")

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ══════════════════════════════════════════════════════════════════════════
// Vagas
// ══════════════════════════════════════════════════════════════════════════

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
}

enum WorkModel {
  ONSITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

/// Os testes que uma vaga pode aplicar. Ver src/lib/instrument/baterias.ts.
///
/// PRUMO é o instrumento da casa — 34 afirmações + 5 situações, cinco fatores —
/// e continua existindo inteiro: virar "uma opção entre quatro" não fatiou nada
/// dele. Os outros três vêm do manual de testes comportamentais.
enum InstrumentoDeTeste {
  PRUMO
  BIG_FIVE
  DISC
  SJT
}

model Job {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?      @db.Text
  requirements   String?      @db.Text
  seniority      Seniority    @default(MID)
  workModel      WorkModel    @default(ONSITE)
  department     String?
  location       String?
  status         JobStatus    @default(DRAFT)

  // Perfil-alvo. `presetId` é só a procedência (qual preset originou);
  // `targetProfile` é a verdade usada no cálculo e é editável pelo recrutador.
  presetId      String?
  targetProfile Json

  // Quais testes esta vaga aplica, na ordem de aplicação. O default garante que
  // toda vaga criada antes desta coluna existir continue se comportando
  // exatamente como antes: só o Prumo.
  //
  // Enum e não Json de propósito — o banco recusa "BIGFIVE" digitado errado, e
  // errar aqui não dá erro de tela: dá uma prova sem aquele teste.
  testBattery InstrumentoDeTeste[] @default([PRUMO])

  // Link público único da vaga: qualquer pessoa com o link responde.
  publicToken   String  @unique @default(cuid())
  publicEnabled Boolean @default(true)

  createdById String?
  createdBy   User?     @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  invitations Invitation[]
  assessments Assessment[]

  @@index([organizationId, status])
}

// ══════════════════════════════════════════════════════════════════════════
// Candidatos e convites
// ══════════════════════════════════════════════════════════════════════════

model Candidate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invitations Invitation[]
  assessments Assessment[]

  // O mesmo e-mail na mesma empresa é a MESMA pessoa — é isso que sustenta
  // o histórico de evolução de candidato recorrente.
  @@unique([organizationId, email])
  @@index([organizationId, name])
}

enum InvitationChannel {
  EMAIL
  LINK
  QRCODE
}

enum InvitationStatus {
  PENDING
  SENT
  OPENED
  STARTED
  COMPLETED
  EXPIRED
  REVOKED
}

model Invitation {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId    String?
  candidate      Candidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  email          String?
  token          String            @unique @default(cuid())

  // Terceira via de entrada, ao lado do link e do QR: 4 dígitos que dá para
  // ditar no telefone ou mandar por WhatsApp. É a MESMA chave do link, não uma
  // senha — quem tem o código entra, igual a quem tem o link.
  //
  // Único no sistema inteiro, e não por vaga, porque a tela `/acesso` não sabe
  // de qual vaga a pessoa veio. Isso só cabe em 4 dígitos porque o código é
  // DEVOLVIDO ao acervo quando a prova termina (volta a ser null): o que
  // precisa ser único é o punhado de convites em aberto, nunca o histórico.
  accessCode     String?           @unique

  channel        InvitationChannel @default(EMAIL)
  status         InvitationStatus  @default(PENDING)
  sentAt         DateTime?
  openedAt       DateTime?
  expiresAt      DateTime
  createdById    String?
  createdBy      User?             @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  assessment Assessment?

  @@index([organizationId, jobId])
  @@index([organizationId, status])
}

// ══════════════════════════════════════════════════════════════════════════
// Avaliações (o teste em si)
// ══════════════════════════════════════════════════════════════════════════

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

/// O que o analista decidiu DEPOIS de ler o resultado e conversar.
///
/// Três opções e não duas: "Dúvida" é o estado real da maioria das pessoas
/// logo depois da entrevista, e obrigar a escolher entre avançar e recusar
/// nesse momento produz decisão apressada — exatamente o que o produto existe
/// para evitar. É também o estado que a lista precisa mostrar em destaque,
/// porque é o único que ainda pede ação de alguém.
enum AnalystDecision {
  ADVANCE
  DOUBT
  REJECT
}

model Assessment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  invitationId   String?          @unique
  invitation     Invitation?      @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  status         AssessmentStatus @default(PENDING)

  // Forma sorteada para ESTA pessoa. `itemOrder` é a ordem de apresentação já
  // resolvida (ver src/lib/instrument/form.ts): sorteio de verdade, mas com as
  // invariantes do instrumento preservadas. `seed` reproduz a mesma forma.
  instrumentVersion String
  seed              String
  itemOrder         Json
  scenarioOrder     Json

  // Cópia CONGELADA da bateria da vaga, tirada quando o convite foi criado.
  //
  // Mesma razão de `itemOrder` ser congelado, um degrau acima: se a prova lesse
  // a bateria da vaga a cada carregamento, o RH acrescentar o DISC no meio da
  // tarde faria quem começou de manhã voltar e encontrar uma aba nova — e o
  // relatório de dois candidatos da mesma vaga passaria a comparar provas
  // diferentes sem nada na tela denunciando.
  testBattery InstrumentoDeTeste[] @default([PRUMO])

  // Resultado consolidado, gravado no encerramento.
  scores             Json? // { C, E, X, A, O } na escala 0-100
  facetNotes         Json? // nuance qualitativa por faceta — nunca número exibido
  fitScore           Float?
  fitDetail          Json? // o que puxou pra cima/baixo, dimensões ignoradas
  confidence         Json? // selo + sinais disparados
  archetypeId        String?
  archetypeMixedWith String?
  percentiles        Json? // só preenchido quando a amostra permite (N ≥ 200)

  // Resultado POR MÓDULO — `ResultadosPorModulo` de src/lib/instrument/baterias.ts.
  //
  // As colunas acima (`scores`, `fitScore`, `archetypeId`…) são a leitura
  // CONSOLIDADA, e continuam sendo: é nelas que o ranking e o painel batem, e
  // reescrevê-las como JSON derrubaria índice, agregação e ordenação. Este
  // campo é a camada de baixo — o que cada teste devolveu por si, incluindo o
  // que não cabe em cinco fatores (o perfil D/I do DISC, a nota por competência
  // do SJT). Nulo enquanto a prova não termina.
  moduleResults Json?

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  lastSeenAt  DateTime?

  // Identificador estável da avaliação, gerado no cadastro.
  //
  // Já foi a credencial de `/r/<token>`, o relatório que o candidato abria
  // sozinho. Essa rota foi removida: o resultado é de quem aplicou o teste. A
  // coluna fica porque é identificador único e barato, e porque derrubá-la
  // custaria uma migração destrutiva sem nada em troca — mas ela NÃO é mais
  // segredo de acesso a nada. Não reintroduza rota pública a partir dela sem
  // reabrir a decisão de produto.
  resultToken String    @unique @default(cuid())
  // Compartilhamento de relatório pela empresa; revogável.
  shareToken  String?   @unique
  sharedAt    DateTime?

  /// ─── O parecer, que até aqui não existia em lugar nenhum ─────────────────
  /// O PDF já trazia uma caixa "Parecer do analista" com três quadradinhos
  /// para preencher à CANETA, e o sistema não tinha campo para guardar nada
  /// disso. O produto existe para embasar uma decisão, e era justamente a
  /// decisão que ele não registrava: quem avaliou, o que concluiu e por quê
  /// ficavam num papel na mesa de alguém.
  ///
  /// O custo não era só de organização. Sem isto, ninguém responde "quem eu já
  /// avaliei e o que decidi", não há como medir quantos avançam, e o pedido de
  /// revisão do art. 20 da LGPD — que trata de decisão automatizada — fica sem
  /// a prova de que houve pessoa decidindo.
  ///
  /// `decidedById` é SetNull: o parecer sobrevive à saída de quem o deu. Perder
  /// a decisão porque o recrutador foi embora seria perder o registro do
  /// processo junto com o crachá.
  decision     AnalystDecision?
  decisionNote String?          @db.Text
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?            @relation("PareceresDoAnalista", fields: [decidedById], references: [id], onDelete: SetNull)

  // LGPD
  consentAt DateTime?
  ipHash    String?
  userAgent String?
  purgedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses         ItemResponse[]
  scenarioResponses ScenarioResponse[]
  choiceResponses   ChoiceResponse[]
  aiAnalysis        AiAnalysis?

  // Uma avaliação por pessoa por vaga — a invariante que o código já assumia
  // sem o banco garantir. `entrarPeloLinkDaVaga` lê e depois escreve, sem
  // transação: dois envios concorrentes do formulário público (recarregar
  // impaciente numa conexão lenta, dois aparelhos, duas abas) criavam duas
  // avaliações da mesma pessoa na mesma vaga. O comentário de `convite.ts` já
  // dizia por que isso é ruim: "duas avaliações da mesma pessoa na mesma vaga
  // bagunçam o ranking". Aqui a corrida vira erro de unicidade, que o código
  // trata redirecionando para a avaliação que ganhou.
  @@unique([jobId, candidateId])
  @@index([organizationId, jobId, status])
  // O painel conta por (empresa, status) o tempo todo; com `jobId` no meio, o
  // índice acima só serve até `organizationId`.
  @@index([organizationId, status, completedAt])
  @@index([candidateId, completedAt])
  // "O que ainda está sem parecer" é a pergunta que a lista faz toda vez que
  // abre, e é a única que sobra depois de o resultado estar pronto.
  @@index([organizationId, decision])
}

// ─── Onde cada teste guarda a resposta bruta ───────────────────────────────
//
// Três formas de pergunta, três tabelas — e a divisão é pela FORMA da resposta,
// nunca pelo teste que a fez. Tabela por teste seria quatro cópias da mesma
// coluna e quatro caminhos de leitura para manter em pé.
//
//   · Likert 1..5, uma pergunta por vez  → ItemResponse   (Prumo, Big Five)
//   · bloco com um MAIS e um MENOS       → ScenarioResponse (Prumo, DISC)
//   · uma alternativa entre várias       → ChoiceResponse  (SJT)
//
// Os `id` de item e de bloco são globais e prefixados por teste (`bf_…`,
// `disc_…`), então a chave única por avaliação segue valendo mesmo com dois
// testes gravando na mesma tabela.

model ItemResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  itemId       String
  value        Int // 1..5 na escala Likert, sempre o valor CRU (sem inversão)
  elapsedMs    Int?
  answeredAt   DateTime   @default(now())

  @@unique([assessmentId, itemId])
}

/// Bloco de escolha forçada: uma opção "primeira/MAIS" e uma "última/MENOS".
///
/// O DISC entra aqui inteiro, sem adaptação: cada um dos 12 blocos exige
/// exatamente 1 MAIS e 1 MENOS, em adjetivos diferentes — que é letra por letra
/// o que estas colunas guardam e o que `salvarCenario` já valida (as duas
/// escolhas precisam ser diferentes, e ambas precisam pertencer ao bloco).
/// Criar uma `DiscResponse` idêntica ao lado seria duplicar tabela, validação e
/// caminho de leitura para ganhar um nome.
model ScenarioResponse {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  blockId       String
  firstActionId String
  lastActionId  String
  elapsedMs     Int?
  answeredAt    DateTime   @default(now())

  @@unique([assessmentId, blockId])
}

/// Escolha única entre alternativas — hoje, o SJT.
///
/// ─── Por que tabela nova, e não uma das duas de cima ──────────────────────
/// Foi a única forma que NÃO encaixou nas existentes, e as duas tentativas
/// falham por motivo de integridade, não de estética:
///
///   · Em `ItemResponse`, `value Int` é documentado e tratado em todo o código
///     como Likert 1..5 sem inversão — é o que `valorDoItem` e `calcularEscores`
///     leem. Guardar ali o número da alternativa faria a resposta do SJT ser
///     lida como afirmação e entrar na média de um fator. O tipo cabe; o
///     significado, não.
///   · Em `ScenarioResponse`, `lastActionId` é NOT NULL e o SJT não tem
///     "MENOS". Só encaixaria escrevendo um valor de mentira ali — e aí toda
///     leitura de MAIS/MENOS passaria a ver uma segunda escolha que a pessoa
///     nunca fez. Afrouxar a coluna para nullable seria pior: tiraria do banco
///     a invariante que sustenta o DISC e o Prumo.
///
/// Guarda só o id da alternativa escolhida. A pontuação ({2,1,1,0}) e a
/// competência ficam no gabarito, no servidor: nunca vão ao front do candidato,
/// nem depois de terminar — expor queima o banco de cenários (manual §4.2).
model ChoiceResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  blockId      String
  choiceId     String
  elapsedMs    Int?
  answeredAt   DateTime   @default(now())

  @@unique([assessmentId, blockId])
}

// ══════════════════════════════════════════════════════════════════════════
// Banco de itens (gerenciável pelo painel administrativo)
// ══════════════════════════════════════════════════════════════════════════

enum Factor {
  C // Conscienciosidade  → Organização e Entrega
  E // Estabilidade       → Estabilidade sob Pressão
  X // Extroversão        → Energia Social
  A // Amabilidade        → Cooperação
  O // Abertura           → Abertura ao Novo
  D // Desejabilidade social — não entra em escore de fator
}

model Item {
  id      String  @id // slug estável: c_org_1
  factor  Factor
  facet   String
  reverse Boolean @default(false)
  text    String  @db.Text

  // Nome de mercado exibido ao recrutador (Comunicação, Liderança, ...).
  // Camada de vocabulário: NÃO é uma dimensão de escoragem.
  marketDimension String?

  // Par de consistência (§5.2). Os dois itens do par compartilham o mesmo valor.
  consistencyPair String?

  isActive  Boolean  @default(true)
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([factor, isActive])
  @@index([consistencyPair])
}

model ScenarioBlock {
  id        String   @id
  situation String   @db.Text
  isActive  Boolean  @default(true)
  version   String   @default("1.0.0")
  createdAt DateTime @default(now())

  actions ScenarioAction[]
}

model ScenarioAction {
  id      String        @id
  blockId String
  block   ScenarioBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  factor  Factor
  text    String        @db.Text

  @@index([blockId])
}

// ══════════════════════════════════════════════════════════════════════════
// IA
// ══════════════════════════════════════════════════════════════════════════

enum AnalysisSource {
  AI
  DETERMINISTIC
}

model AiAnalysis {
  id            String         @id @default(cuid())
  assessmentId  String         @unique
  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  source        AnalysisSource
  model         String?
  promptVersion String         @default("1.0.0")

  summary            String @db.Text
  behavioralReading  String @db.Text
  strengths          Json
  watchpoints        Json
  interviewQuestions Json
  fitNarrative       String @db.Text
  roleSuggestions    Json

  tokensUsed  Int?
  generatedAt DateTime @default(now())
}

// ══════════════════════════════════════════════════════════════════════════
// Cultura organizacional (matching)
// ══════════════════════════════════════════════════════════════════════════

model CultureProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?      @db.Text
  dimensions     Json // mesma forma do targetProfile da vaga
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// ══════════════════════════════════════════════════════════════════════════
// Normas / benchmark de mercado
// ══════════════════════════════════════════════════════════════════════════

// Amostra acumulada para percentil. §4.3: só exibe percentil a partir de N=200,
// e sempre com o N visível. Recalculada por job/cron.
model NormSample {
  id         String   @id @default(cuid())
  scope      String   @default("GLOBAL") // GLOBAL | SENIORITY | DEPARTMENT
  scopeKey   String   @default("all")
  factor     Factor
  n          Int
  mean       Float
  sd         Float
  buckets    Json // distribuição para o cálculo de percentil
  computedAt DateTime @default(now())

  @@unique([scope, scopeKey, factor])
}

// ══════════════════════════════════════════════════════════════════════════
// Segurança, auditoria e API pública
// ══════════════════════════════════════════════════════════════════════════

enum AuditCategory {
  AUTH
  ACCESS
  MUTATION
  EXPORT
  ADMIN
  PRIVACY
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  category       AuditCategory
  action         String
  entity         String?
  entityId       String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([category, createdAt])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  prefix         String       @unique
  hashedKey      String
  scopes         Json
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model RateLimitCounter {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}
